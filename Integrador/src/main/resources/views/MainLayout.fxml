<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="ar.edu.unam.veterinaria.controller.MainLayoutController"
            stylesheets="@style.css" prefWidth="1366.0" prefHeight="768.0">
    <left>
        <VBox fx:id="sidebar" styleClass="sidebar-container" spacing="5.0" prefWidth="260.0">
            <padding><Insets top="30.0" right="15.0" bottom="20.0" left="15.0"/></padding>
            
            <!-- LOGO -->
            <HBox alignment="CENTER_LEFT" spacing="15.0" styleClass="logo-container">
                <padding><Insets left="10.0" bottom="25.0"/></padding>
                <FontIcon iconLiteral="fas-plus-square" iconSize="32" styleClass="logo-icon"/>
                <VBox alignment="CENTER_LEFT" spacing="2.0">
                    <Label text="Huellas &amp; Salud" styleClass="logo-title"/>
                    <Label text="CENTRO VETERINARIO" styleClass="logo-subtitle"/>
                </VBox>
            </HBox>
            <StackPane styleClass="nav-divider" maxHeight="1.0" />
            
            <Label text="MÓDULOS" styleClass="sidebar-section-title">
                <padding><Insets left="15.0" top="15.0" bottom="5.0"/></padding>
            </Label>
            
            <!-- BOTONES DINÁMICOS -->
            <Button fx:id="btnClientes" onAction="#cargarVistaClientes" maxWidth="Infinity" contentDisplay="GRAPHIC_ONLY" styleClass="nav-button">
                <graphic>
                    <HBox alignment="CENTER_LEFT" spacing="12.0">
                        <FontIcon iconLiteral="fas-user-friends" iconSize="16" styleClass="nav-icon"/>
                        <Label text="Clientes" styleClass="nav-text"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="•" styleClass="nav-dot"/>
                    </HBox>
                </graphic>
            </Button>

            <Button fx:id="btnTurnos" onAction="#cargarVistaTurnos" maxWidth="Infinity" contentDisplay="GRAPHIC_ONLY" styleClass="nav-button">
                <graphic>
                    <HBox alignment="CENTER_LEFT" spacing="12.0">
                        <FontIcon iconLiteral="fas-calendar-alt" iconSize="16" styleClass="nav-icon"/>
                        <Label text="Turnos" styleClass="nav-text"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="•" styleClass="nav-dot"/>
                    </HBox>
                </graphic>
            </Button>

            <Button fx:id="btnHistorial" onAction="#cargarVistaHistorial" maxWidth="Infinity" contentDisplay="GRAPHIC_ONLY" styleClass="nav-button">
                <graphic>
                    <HBox alignment="CENTER_LEFT" spacing="12.0">
                        <FontIcon iconLiteral="fas-notes-medical" iconSize="16" styleClass="nav-icon"/>
                        <Label text="Historial Médico" styleClass="nav-text"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="•" styleClass="nav-dot"/>
                    </HBox>
                </graphic>
            </Button>

            <Button fx:id="btnVacunaciones" onAction="#cargarVistaVacunaciones" maxWidth="Infinity" contentDisplay="GRAPHIC_ONLY" styleClass="nav-button">
                <graphic>
                    <HBox alignment="CENTER_LEFT" spacing="12.0">
                        <FontIcon iconLiteral="fas-syringe" iconSize="16" styleClass="nav-icon"/>
                        <Label text="Vacunaciones" styleClass="nav-text"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="•" styleClass="nav-dot"/>
                    </HBox>
                </graphic>
            </Button>

            <Button fx:id="btnVeterinarios" onAction="#cargarVistaVeterinarios" maxWidth="Infinity" contentDisplay="GRAPHIC_ONLY" styleClass="nav-button">
                <graphic>
                    <HBox alignment="CENTER_LEFT" spacing="12.0">
                        <FontIcon iconLiteral="fas-user-md" iconSize="16" styleClass="nav-icon"/>
                        <Label text="Veterinarios" styleClass="nav-text"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="•" styleClass="nav-dot"/>
                    </HBox>
                </graphic>
            </Button>

            <Button fx:id="btnGuarderia" onAction="#cargarVistaGuarderia" maxWidth="Infinity" contentDisplay="GRAPHIC_ONLY" styleClass="nav-button">
                <graphic>
                    <HBox alignment="CENTER_LEFT" spacing="12.0">
                        <FontIcon iconLiteral="fas-paw" iconSize="16" styleClass="nav-icon"/>
                        <Label text="Guardería &amp; Peluquería" styleClass="nav-text"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="•" styleClass="nav-dot"/>
                    </HBox>
                </graphic>
            </Button>
            
            <Region VBox.vgrow="ALWAYS" />
            
            <!-- BOTONES INFERIORES -->
            <Button text="Configuración" maxWidth="Infinity" contentDisplay="GRAPHIC_ONLY" styleClass="nav-button">
                <graphic>
                    <HBox alignment="CENTER_LEFT" spacing="12.0">
                        <FontIcon iconLiteral="fas-cog" iconSize="16" styleClass="nav-icon"/>
                        <Label text="Configuración" styleClass="nav-text"/>
                    </HBox>
                </graphic>
            </Button>
            <Button text="Cerrar sesión" maxWidth="Infinity" contentDisplay="GRAPHIC_ONLY" styleClass="nav-button, logout-button">
                <graphic>
                    <HBox alignment="CENTER_LEFT" spacing="12.0">
                        <FontIcon iconLiteral="fas-sign-out-alt" iconSize="16" styleClass="logout-icon"/>
                        <Label text="Cerrar sesión" styleClass="nav-text, logout-text"/>
                    </HBox>
                </graphic>
            </Button>
        </VBox>
    </left>
    <center>
        <StackPane fx:id="contentArea" styleClass="main-content-area">
            <!-- El contenido dinámico va acá -->
        </StackPane>
    </center>
</BorderPane>