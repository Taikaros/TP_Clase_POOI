<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml/1">
    
    <!-- Criterio 2: Buscador de mascotas superior -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-padding: 15;">
            <Label text="Buscar Mascota:" />
            <TextField promptText="Nombre o ID..." HBox.hgrow="ALWAYS" />
            <Button text="Buscar" />
        </HBox>
    </top>

    <!-- Criterio 4: Tabla lateral para visualizar consultas anteriores -->
    <right>
        <VBox spacing="10.0" style="-fx-padding: 15;" prefWidth="250.0">
            <Label text="Historial de Consultas" style="-fx-font-weight: bold;" />
            <TableView VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn text="Fecha" prefWidth="90.0"/>
                    <TableColumn text="Motivo" prefWidth="150.0"/>
                </columns>
            </TableView>
        </VBox>
    </right>

    <!-- Criterio 3: Campos amplios para diagnóstico y tratamiento -->
    <center>
        <VBox spacing="10.0" style="-fx-padding: 15;">
            <Label text="Diagnóstico:" style="-fx-font-weight: bold;" />
            <TextArea wrapText="true" VBox.vgrow="ALWAYS" />
            
            <Label text="Tratamiento:" style="-fx-font-weight: bold;" />
            <TextArea wrapText="true" VBox.vgrow="ALWAYS" />
        </VBox>
    </center>

</BorderPane>